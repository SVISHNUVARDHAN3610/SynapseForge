{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SynapseForge: FastAPI Local Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["synapseforge.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "SynapseForge: Debug Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests/test_synapseforge.py"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    }
  ]
}
